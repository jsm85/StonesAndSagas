---
/* The heading block every catalogue page opens with: a mono stamp, a title and
   a line of explanation. Consistent by construction rather than by each page
   remembering the same three elements. */

interface Props {
  stamp: string;
  title: string;
  lede?: string;
}

const { stamp, title, lede } = Astro.props;
---

<header class="intro">
  <p class="sas-stamp">{stamp}</p>
  <h1 class="sas-glow-text">{title}</h1>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .intro {
    margin-bottom: var(--sas-space-lg);
  }

  h1 {
    margin: var(--sas-space-2xs) 0 0;
    font-family: var(--sas-font-display);
    font-size: clamp(1.5rem, 4vw, 2.35rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .lede {
    margin: var(--sas-space-sm) 0 0;
    max-width: 62ch;
    font-size: 1.0625rem;
    color: var(--sas-text-muted);
  }
</style>
