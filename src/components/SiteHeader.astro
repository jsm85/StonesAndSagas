---
/*
 * Sticky header: the wordmark, the navigation, and a telemetry pill borrowed
 * from the design's "SIGNAL OK" badge.
 *
 * The nav arrived with the catalogue — it was deliberately absent while the site
 * was one page, since links to routes that do not exist are worse than no links.
 * The current section is marked with aria-current, matched on the path prefix so
 * a detail page still highlights its section.
 */

import { href } from '../lib/href';

const sections = [
  { label: 'Timeline', path: 'timeline' },
  { label: 'Titles', path: 'titles' },
  { label: 'Threads', path: 'threads' },
  { label: 'Characters', path: 'characters' },
  { label: 'Reading', path: 'reading' },
];

const current = Astro.url.pathname;

interface Props {
  /* What the telemetry pill reads. Kept honest — it reports the state of the
     project, not decorative fake status. */
  status: string;
}

const { status } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href={import.meta.env.BASE_URL}>
    <span class="wordmark-orb" aria-hidden="true"></span>
    <span class="wordmark-text">
      <span class="wordmark-name">Stones &amp; Sagas</span>
      <span class="wordmark-sub">Unofficial MCU field guide</span>
    </span>
  </a>

  <nav class="nav" aria-label="Sections">
    <ul>
      {
        sections.map((section) => (
          <li>
            <a
              href={href(section.path)}
              aria-current={current.startsWith(href(section.path)) ? 'page' : undefined}
            >
              {section.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="telemetry">
    <span class="telemetry-light" aria-hidden="true"></span>
    <span>{status}</span>
  </p>
</header>

<style>
  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sas-space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--sas-font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--sas-track-wider);
    text-transform: uppercase;
  }

  .nav a {
    color: var(--sas-text-muted);

    &:hover {
      color: var(--sas-cyan-bright);
    }

    /* The current section keeps the magenta lead and a rule under it, so the
       header says where you are without a second visual language. */
    &[aria-current='page'] {
      color: var(--sas-magenta-bright);
      border-bottom: 1px solid var(--sas-magenta);
      padding-bottom: 0.2em;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sas-space-md);
    padding: var(--sas-space-sm) var(--sas-gutter);
    background: color-mix(in oklab, var(--sas-void) 74%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--sas-hairline);
    box-shadow:
      0 1px 0 oklch(0.70 0.18 350 / 0.18),
      0 10px 40px -20px var(--sas-glow-magenta);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: inherit;

    &:hover .wordmark-name {
      color: var(--sas-cyan-bright);
    }
  }

  /* An abstract three-colour orb — self-made, and carrying no resemblance to
     any studio mark. It is the whole palette in one 24px circle. */
  .wordmark-orb {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(
      160deg,
      var(--sas-amber),
      var(--sas-magenta) 55%,
      var(--sas-violet)
    );
    box-shadow:
      inset 0 0 0 4px var(--sas-void),
      0 0 16px oklch(0.70 0.18 350 / 0.65);
  }

  .wordmark-text {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    line-height: 1;
  }

  .wordmark-name {
    font-family: var(--sas-font-display);
    font-size: 0.8125rem;
    letter-spacing: var(--sas-track-wide);
    text-transform: uppercase;
    color: var(--sas-text);
    transition: color var(--sas-transition) ease;
  }

  .wordmark-sub {
    font-family: var(--sas-font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sas-cyan);
  }

  .telemetry {
    display: flex;
    align-items: center;
    gap: var(--sas-space-xs);
    flex: 0 0 auto;
    margin: 0;
    padding: var(--sas-space-2xs) 0.75rem;
    border: 1px solid var(--sas-hairline-cool);
    border-radius: 999px;
    font-family: var(--sas-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--sas-cyan);
  }

  .telemetry-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sas-cyan);
    box-shadow: 0 0 10px var(--sas-cyan);
    animation: sas-pulse var(--sas-pulse-duration) ease-in-out infinite;
  }

  /* Three things across one bar stops working well before the viewport gets
     narrow. The nav is the one that wraps: it goes full width on its own line
     under the wordmark and pill, rather than squeezing either. */
  @media (width < 64rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: var(--sas-space-sm);
    }

    .nav {
      order: 3;
      width: 100%;
    }
  }

  /* Below ~30rem the pill and the wordmark stop fitting side by side. The
     wordmark wins; the pill drops to its own line rather than being truncated. */
  @media (width < 30rem) {
    .site-header {
      gap: var(--sas-space-xs);
    }
  }
</style>
