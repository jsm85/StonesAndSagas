---
/*
 * The icon set: twelve glyphs, one per kind the catalogue labels.
 *
 * Drawn here rather than pulled from a library. An icon package brings a house
 * style with it, and this one is specific — geometric, thin-stroked, closer to
 * an instrument panel than to a UI kit. Twelve shapes this simple are also
 * smaller than the dependency that would draw them.
 *
 * Rules they all follow, so they sit together:
 *   - a 24×24 box, with the figure inside a 20×20 area
 *   - stroke only, 1.5 units, `currentColor`, so an icon takes the accent of
 *     whatever it sits in and needs no per-colour variant
 *   - no fills, no gradients, nothing that assumes a background
 *
 * Every icon is decorative. The label it sits beside always stays in the markup:
 * these sharpen a list that is already readable, they do not replace words.
 */

import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
  /* Matches the cap height of the mono labels these sit next to. */
  size?: number;
  class?: string;
}

const { name, size = 14, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {/* A frame of film: the gate, with sprockets down both edges. */}
  {
    name === 'film' && (
      <>
        <rect x="3" y="4" width="18" height="16" />
        <path d="M7 4v16M17 4v16" />
        <path d="M3 9h4M3 15h4M17 9h4M17 15h4" />
      </>
    )
  }

  {/* A series: many units, stacked and offset. */}
  {
    name === 'series' && (
      <>
        <rect x="3" y="8" width="14" height="12" />
        <path d="M6 5h14v12" />
      </>
    )
  }

  {/* A short: the film gate, narrower — the same thing at a smaller run time. */}
  {
    name === 'short' && (
      <>
        <rect x="6" y="4" width="12" height="16" />
        <path d="M11 4v16" />
        <path d="M6 9h5M6 15h5" />
      </>
    )
  }

  {/* An object: a cut stone. The Infinity Stones set the shape for all of them. */}
  {
    name === 'object' && (
      <>
        <path d="M12 3 21 9v6l-9 6-9-6V9z" />
        <path d="M3 9h18M12 3v18" />
      </>
    )
  }

  {/* A location: a world, not a map pin. It is a site in space, and a globe
      keeps its shape at 12px where a ringed planet turns to mush. */}
  {
    name === 'location' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <ellipse cx="12" cy="12" rx="4" ry="9" />
      </>
    )
  }

  {/* An organisation: nodes reporting to a node. */}
  {
    name === 'organisation' && (
      <>
        <circle cx="12" cy="5" r="2.5" />
        <circle cx="5" cy="19" r="2.5" />
        <circle cx="19" cy="19" r="2.5" />
        <path d="M12 7.5v4M12 11.5H5.5v5M12 11.5h6.5v5" />
      </>
    )
  }

  {/* An event: something happening at a point, radiating outward. */}
  {
    name === 'event' && (
      <>
        <circle cx="12" cy="12" r="3" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2" />
      </>
    )
  }

  {/* A reality: two worlds overlapping.
      This started as a branching timeline, which is the better idea and the
      worse glyph — at the 12px these actually render at, the stem and the node
      dropped out and left a bare '<'. Two rings survive the size. */}
  {
    name === 'reality' && (
      <>
        <circle cx="9" cy="12" r="6.5" />
        <circle cx="15" cy="12" r="6.5" />
      </>
    )
  }

  {/* An issue: a single book with a folded corner. */}
  {
    name === 'issue' && (
      <>
        <path d="M5 3h9l5 5v13H5z" />
        <path d="M14 3v5h5" />
      </>
    )
  }

  {/* A collection: several issues bound together. */}
  {
    name === 'collection' && (
      <>
        <path d="M4 6h8v15H4z" />
        <path d="M12 6h8v15h-8z" />
        <path d="M12 3v18" />
      </>
    )
  }

  {/* A book: a spine and a text block. */}
  {
    name === 'book' && (
      <>
        <path d="M5 4h13a2 2 0 0 1 2 2v14H7a2 2 0 0 1-2-2z" />
        <path d="M5 18h15" />
        <path d="M9 8h7" />
      </>
    )
  }
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.12em;
    /* Icons sit next to labels running at 0.6rem with wide tracking; at full
       opacity they shout over them. */
    opacity: 0.85;
  }
</style>
