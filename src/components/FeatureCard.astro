---
/*
 * A card for one planned feature.
 *
 * The design mock puts a film still at the top of each of these. We cannot ship
 * one — studio stills are exactly the copyrighted media the project's IP rules
 * prohibit. So the image area is a "plate": an abstract, procedurally drawn
 * gradient keyed to the card's accent colour. It is generated from CSS, so it
 * is self-made by construction, weighs nothing, and holds the composition the
 * design wants without borrowing anyone's artwork.
 */

type Accent = 'magenta' | 'cyan' | 'amber';

interface Props {
  /* Mono eyebrow above the title. */
  label: string;
  title: string;
  body: string;
  accent: Accent;
}

const { label, title, body, accent } = Astro.props;
---

<article class="feature-card" data-accent={accent}>
  <div class="plate" aria-hidden="true"></div>
  <div class="feature-body">
    <p class="feature-label">{label}</p>
    <h3 class="feature-title">{title}</h3>
    <p class="feature-text">{body}</p>
  </div>
</article>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sas-hairline);
    background: linear-gradient(180deg, var(--sas-panel-top), var(--sas-panel-bottom));
    transition:
      border-color var(--sas-transition) ease,
      transform var(--sas-transition) ease,
      box-shadow var(--sas-transition) ease;

    &:hover {
      border-color: var(--sas-cyan);
      transform: translateY(-4px);
      box-shadow: 0 18px 40px -24px var(--sas-glow-cyan);
    }
  }

  /* Each accent picks its own hue for the plate and the eyebrow. Set once here
     so the card body below can stay accent-agnostic. */
  .feature-card[data-accent='magenta'] {
    --card-accent: var(--sas-magenta);
    --card-accent-bright: var(--sas-magenta-bright);
  }

  .feature-card[data-accent='cyan'] {
    --card-accent: var(--sas-cyan);
    --card-accent-bright: var(--sas-cyan-bright);
  }

  .feature-card[data-accent='amber'] {
    --card-accent: var(--sas-amber);
    --card-accent-bright: var(--sas-amber);
  }

  /* Two nebula blooms and a scatter of stars — the same vocabulary as the page
     backdrop, compressed into a 9.5rem band.
     Every stop is a soft radial: an earlier version drew a 1px horizon line
     across the plate, and a hard full-width edge reads as a progress bar, not
     as light. The accent glow is pushed off-centre and kept well inside the
     plate's width so it stays a glow rather than a band. */
  .plate {
    height: 9.5rem;
    border-bottom: 1px solid var(--sas-hairline);
    background-color: var(--sas-void-deep);
    background-image:
      radial-gradient(1.2px 1.2px at 24% 30%, rgb(255 255 255 / 0.9) 50%, transparent 51%),
      radial-gradient(1px 1px at 68% 18%, rgb(255 255 255 / 0.7) 50%, transparent 51%),
      radial-gradient(1.4px 1.4px at 82% 62%, rgb(200 225 255 / 0.6) 50%, transparent 51%),
      radial-gradient(44% 52% at 28% 96%, color-mix(in oklab, var(--card-accent) 60%, transparent), transparent 70%),
      radial-gradient(58% 78% at 86% -12%, oklch(0.62 0.14 255 / 0.38), transparent 70%);
    background-repeat: no-repeat;
  }

  .feature-body {
    padding: var(--sas-space-md) var(--sas-space-md) var(--sas-space-lg);
  }

  .feature-label {
    margin: 0 0 var(--sas-space-xs);
    font-family: var(--sas-font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--sas-track-widest);
    text-transform: uppercase;
    color: var(--card-accent-bright);
  }

  .feature-title {
    margin: 0 0 var(--sas-space-xs);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .feature-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--sas-text-muted);
  }
</style>
