---
/*
 * A card for one planned feature.
 *
 * The image area is a plate — see Plate.astro for what that is and why the
 * design has one instead of a film still.
 */

import Plate from './Plate.astro';

type Accent = 'magenta' | 'cyan' | 'amber';

interface Props {
  /* Mono eyebrow above the title. */
  label: string;
  title: string;
  body: string;
  accent: Accent;
  /* Where the feature actually lives, now that all three do. */
  href: string;
  cta: string;
}

const { label, title, body, accent, href, cta } = Astro.props;
---

<article class="feature-card" data-accent={accent}>
  <Plate accent={accent} />
  <div class="feature-body">
    <p class="feature-label">{label}</p>
    <h3 class="feature-title">{title}</h3>
    <p class="feature-text">{body}</p>
    <p class="feature-cta"><a href={href}>{cta} →</a></p>
  </div>
</article>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sas-hairline);
    background: linear-gradient(180deg, var(--sas-panel-top), var(--sas-panel-bottom));
    transition:
      border-color var(--sas-transition) ease,
      transform var(--sas-transition) ease,
      box-shadow var(--sas-transition) ease;

    &:hover {
      border-color: var(--sas-cyan);
      transform: translateY(-4px);
      box-shadow: 0 18px 40px -24px var(--sas-glow-cyan);
    }
  }

  .feature-card {
    position: relative;
  }

  .feature-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--sas-space-md) var(--sas-space-md) var(--sas-space-lg);
  }

  /* Pushed to the bottom so the three cards' links line up whatever the body
     length, and stretched over the whole card so the card is one link. */
  .feature-cta {
    margin: auto 0 0;
    padding-top: var(--sas-space-md);
    font-family: var(--sas-font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--sas-track-wider);
    text-transform: uppercase;

    & a::after {
      content: '';
      position: absolute;
      inset: 0;
    }
  }

  .feature-label {
    margin: 0 0 var(--sas-space-xs);
    font-family: var(--sas-font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--sas-track-widest);
    text-transform: uppercase;
    color: var(--sas-accent-bright);
  }

  .feature-title {
    margin: 0 0 var(--sas-space-xs);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .feature-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--sas-text-muted);
  }
</style>
